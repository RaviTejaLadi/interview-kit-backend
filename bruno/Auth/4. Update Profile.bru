meta {
  name: 4. Update Profile
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/auth/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Ravi",
    "lastName": "Ladi",
    "userName": "raviladi",
    "phoneNumber": "9876543211",
    "dob": "1998-05-12",
    "bio": "Full stack developer"
  }
}
