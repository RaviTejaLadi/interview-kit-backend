meta {
  name: 5. Change Password
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "Password@123",
    "newPassword": "NewPassword@123"
  }
}
