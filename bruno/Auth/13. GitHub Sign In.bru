meta {
  name: 13. GitHub Sign In
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/auth/github
  body: none
  auth: none
}

docs {
  Open this URL in a browser. GitHub redirects back to the API, which then
  redirects the browser to the frontend /oauth/callback with the session tokens
  in the URL hash and in cookies.
}
