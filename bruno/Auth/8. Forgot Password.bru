meta {
  name: 8. Forgot Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "ravi@example.com"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data && res.body.data.otp) {
    bru.setEnvVar("resetOtp", res.body.data.otp);
  }
}
