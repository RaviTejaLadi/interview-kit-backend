meta {
  name: 10. Reset Password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "ravi@example.com",
    "resetToken": "{{resetToken}}",
    "newPassword": "NewPassword@123"
  }
}
