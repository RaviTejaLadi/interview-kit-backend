meta {
  name: 1. Submit Feedback
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Interview flow",
    "description": "The timer reset after the second question."
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.data && res.body.data.feedback) {
    bru.setEnvVar("feedbackId", res.body.data.feedback.id);
  }
}
