meta {
  name: 2. Start Chat
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "message": "Explain how AI works in a few words"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.data && res.body.data.chat) {
    bru.setEnvVar("chatId", res.body.data.chat.id);
  }
}
